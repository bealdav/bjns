<odoo>

    <record id="easy_payment_wiz_form" model="ir.ui.view">
        <field name="model">easy.payment.wiz</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <group>
                        <field name="payment_method_line_id" widget="radio" domain="payment_domain"/>
                        <field name="payment_domain" invisible="1" />
                        <field name="company_id" invisible="1" />
                    </group>
                    <group>
                        <field name="amount" />
                        <field name="due" invisible="payment_method_line_id" />
                        <field name="payment_date" readonly="1" />
                    </group>
                    <group colspan="4" invisible="payment_method_line_id">
                        <field name="line_ids" nolabel="1" mode="list" >
                            <list editable="bottom" edit="1">
                                <field name="payment_method_line_id" domain="payment_domain"
                                    required="1" options="{'no_create': 1}"/>
                                <field name="amount" />
                                <field name="payment_domain" column_invisible="1" />
                            </list>
                        </field>
                    </group>
                </group>
                <footer>
                    <button string="Payer" type="object" name="invoice_and_pay" class="btn-primary"
                        invisible="not payment_method_line_id and due" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="easy_payment_wiz_action" model="ir.actions.act_window">
        <field name="name">Easy payment</field>
        <field name="res_model">easy.payment.wiz</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
