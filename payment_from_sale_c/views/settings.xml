<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='account_batch_payment']" position="after">
                <setting id="quick_payment_method" string="Quick Sale Payments" help="Contacter akretion avant de modifier" />
                <field name="quick_payment_method_ids" widget="many2many"  />
            </xpath>
        </field>
    </record>

</odoo>
